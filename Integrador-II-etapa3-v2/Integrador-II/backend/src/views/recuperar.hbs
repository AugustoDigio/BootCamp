<section class="auth-section">
  <div class="container">
    <div class="auth-card" style="max-width:440px;">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center gap-2 mb-3">
          <span class="brand-icon"><i class="bi bi-cpu-fill"></i></span>
          <span class="brand-text">TECH<span class="brand-accent">STORE</span></span>
        </div>
        <h2 class="auth-title">Restablecer contraseña</h2>
        <p class="auth-subtitle">Ingresá tu email y te enviamos un enlace para crear una nueva contraseña</p>
      </div>

      {{#if error}}
      <div class="alert-error">
        <i class="bi bi-exclamation-circle me-2"></i>{{error}}
      </div>
      {{/if}}

      {{#if success}}
      <div class="alert-success">
        <i class="bi bi-check-circle me-2"></i>{{success}}
      </div>
      {{/if}}

      {{#unless success}}
      <form action="/recuperar" method="POST" id="recuperarForm" novalidate>
        <div class="mb-4">
          <label for="email" class="form-label">Email de tu cuenta</label>
          <input type="email" class="form-control" id="email" name="email"
            placeholder="usuario@ejemplo.com" />
          <div class="field-error" id="emailError"></div>
        </div>

        <button type="submit" class="btn-primary-ts">
          <i class="bi bi-send me-2"></i>Enviar enlace de recuperación
        </button>
      </form>
      {{/unless}}

      <div class="text-center mt-4">
        <a href="/login" class="auth-link" style="font-size:0.9rem;">
          <i class="bi bi-arrow-left me-1"></i>Volver al login
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.alert-error {
  background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
  color: #ef4444; border-radius: 10px; padding: 0.75rem 1rem;
  font-size: 0.9rem; margin-bottom: 1.25rem;
}
.alert-success {
  background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3);
  color: #10b981; border-radius: 10px; padding: 0.75rem 1rem;
  font-size: 0.9rem; margin-bottom: 1.25rem;
}
.field-error { color: #ef4444; font-size: 0.8rem; margin-top: 0.3rem; min-height: 1.1rem; }
.form-control.is-invalid { border-color: rgba(239,68,68,0.5) !important; }
</style>

<script>
document.getElementById('recuperarForm')?.addEventListener('submit', function(e) {
  const email = document.getElementById('email');
  const emailError = document.getElementById('emailError');

  email.classList.remove('is-invalid');
  emailError.textContent = '';

  if (!email.value.trim()) {
    email.classList.add('is-invalid');
    emailError.textContent = 'El email es obligatorio';
    e.preventDefault();
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
    email.classList.add('is-invalid');
    emailError.textContent = 'Ingresá un email válido';
    e.preventDefault();
  }
});
</script>
