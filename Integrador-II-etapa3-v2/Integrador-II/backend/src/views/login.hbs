<section class="auth-section">
  <div class="container">
    <div class="auth-card">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center gap-2 mb-3">
          <span class="brand-icon"><i class="bi bi-cpu-fill"></i></span>
          <span class="brand-text">TECH<span class="brand-accent">STORE</span></span>
        </div>
        <h2 class="auth-title">Bienvenido de vuelta</h2>
        <p class="auth-subtitle">Iniciá sesión para continuar</p>
      </div>

      {{#if error}}
      <div class="alert-error">
        <i class="bi bi-exclamation-circle me-2"></i>{{error}}
      </div>
      {{/if}}

      <form action="/login" method="POST" id="loginForm" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email"
            placeholder="usuario@ejemplo.com" />
          <div class="field-error" id="emailError"></div>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <label for="password" class="form-label mb-0">Contraseña</label>
          </div>
          <div class="position-relative mt-1">
            <input type="password" class="form-control" id="password" name="password"
              placeholder="••••••••" />
            <button type="button" class="btn-toggle-pass" onclick="togglePass('password', this)">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="field-error" id="passwordError"></div>
        </div>

        <button type="submit" class="btn-primary-ts">
          <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
        </button>
      </form>

      <div class="auth-divider mt-4">o</div>

      <div class="text-center">
        <p style="color: var(--ts-muted); font-size:0.9rem; margin-bottom:0;">
          ¿No tenés cuenta?
          <a href="/registro" class="auth-link ms-1">Registrate gratis</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
.btn-toggle-pass {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  background: none; border: none; color: var(--ts-muted); cursor: pointer;
  padding: 0; font-size: 1rem; transition: color 0.2s;
}
.btn-toggle-pass:hover { color: var(--ts-accent); }
.alert-error {
  background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
  color: #ef4444; border-radius: 10px; padding: 0.75rem 1rem;
  font-size: 0.9rem; margin-bottom: 1.25rem;
}
.field-error { color: #ef4444; font-size: 0.8rem; margin-top: 0.3rem; min-height: 1.1rem; }
.form-control.is-invalid { border-color: rgba(239,68,68,0.5) !important; }
</style>

<script>
function togglePass(fieldId, btn) {
  const input = document.getElementById(fieldId);
  const icon = btn.querySelector('i');
  if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
  else { input.type = 'password'; icon.className = 'bi bi-eye'; }
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
  let valid = true;

  const email = document.getElementById('email');
  const emailError = document.getElementById('emailError');
  const password = document.getElementById('password');
  const passwordError = document.getElementById('passwordError');

  // Reset
  email.classList.remove('is-invalid');
  password.classList.remove('is-invalid');
  emailError.textContent = '';
  passwordError.textContent = '';

  // Validar email
  if (!email.value.trim()) {
    email.classList.add('is-invalid');
    emailError.textContent = 'El email es obligatorio';
    valid = false;
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
    email.classList.add('is-invalid');
    emailError.textContent = 'Ingresá un email válido';
    valid = false;
  }

  // Validar contraseña
  if (!password.value) {
    password.classList.add('is-invalid');
    passwordError.textContent = 'La contraseña es obligatoria';
    valid = false;
  }

  if (!valid) e.preventDefault();
});
</script>
